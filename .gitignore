# ==============================================================================
# .gitignore — Escola de Artes Helena Barufaldi
# ==============================================================================

# --- Ambientes Virtuais Python ---
venv/
.venv/
env/
test_venv/
ENV/

# --- Bytecode e Caches Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testes e Cobertura ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# --- Frontend e Node.js ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- Banco de Dados Local SQLite ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Preserva a pasta de backups locais ignorando os snapshots .db e credenciais locais
backups/*.db
backups/.supabase_config.json
!backups/.gitkeep

# --- Variáveis de Ambiente e Segredos ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Arquivos de Sistema Operacional ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editores e IDEs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
